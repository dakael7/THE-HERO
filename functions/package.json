    "firebase-admin": "^10.3.0",
    "firebase-functions": "^4.9.0",
    "mercadopago": "^2.0.15",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "sharp": "^0.33.2",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
