# ============================================================================
# Firebase Functions - environment template
# Copy to `.env` for local/dev use.
# Do not put production secrets here.
# ============================================================================

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------
SUPPORT_EMAIL_ALLOWLIST=theherov1.0@gmail.com


# ----------------------------------------------------------------------------
# MercadoPago
# ----------------------------------------------------------------------------
# Secret Manager (required in prod):
# - MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_SIMULATOR_ENABLED=false


# ----------------------------------------------------------------------------
# SimpleAPI - Factura DTE
# ----------------------------------------------------------------------------
SIMPLEAPI_BASE_URL=https://api.simpleapi.cl
# Optional explicit endpoints (if your provider gave custom URLs):
# SIMPLEAPI_DTE_GENERATE_URL=https://api.simpleapi.cl/api/v1/dte/generar
# SIMPLEAPI_PDF_GENERATE_URL=https://api.simpleapi.cl/api/v1/impresion/pdf/carta/v2
# Si true, fuerza endpoint PDF .../cedible (recomendado para muestras impresas SII).
SIMPLEAPI_PDF_USE_CEDIBLE=true
# SIMPLEAPI_ENVIO_GENERATE_URL=https://api.simpleapi.cl/api/v1/Envio/generar
# SIMPLEAPI_ENVIO_SEND_URL=https://api.simpleapi.cl/api/v1/Envio/enviar
# SIMPLEAPI_CONSULTA_ENVIO_URL=https://api.simpleapi.cl/api/v1/Consulta/envio
# Optional: retries with next folio if provider reports folio already used
SIMPLEAPI_FOLIO_RETRY_LIMIT=3
# Optional: enable SII send pipeline and status query
SIMPLEAPI_ENABLE_SII_SEND=false
SIMPLEAPI_REQUIRE_SII_SEND=true
SIMPLEAPI_ENABLE_SII_STATUS_QUERY=true
# Optional values used by /Envio/* and /Consulta/envio
# SIMPLEAPI_SII_SEND_TYPE=1
# SIMPLEAPI_SII_AMBIENTE=0
# SIMPLEAPI_SII_NOTIFICACION_EMAIL=
# SIMPLEAPI_SII_RECEPTOR_RUT=60803000-K
# SIMPLEAPI_SII_CERT_RUTA=
# SIMPLEAPI_SII_INCLUDE_AUTH=false
# SIMPLEAPI_SII_AUTH_RUT=
# SIMPLEAPI_SII_AUTH_PASSWORD=
# SIMPLEAPI_ENVIO_SEND_RETRY_LIMIT=1
# SIMPLEAPI_ENVIO_SEND_RETRY_BACKOFF_MS=1200

# Secret Manager (required in prod):
# - SIMPLEAPI_API_KEY
# - SIMPLEAPI_PFX_PASSWORD
SIMPLEAPI_CERT_RUT=27948403-7

# Private files in Cloud Storage
SIMPLEAPI_PFX_STORAGE_PATH=fiscal-secrets/certs/27948403-7.p12
SIMPLEAPI_CAF_STORAGE_PATH=fiscal-secrets/caf/FoliosSII783301033312026514161.xml
# CAF por tipo de DTE (recomendado para emision multi-documento)
# SIMPLEAPI_CAF_STORAGE_PATH_33=fiscal-secrets/caf/FoliosSII....xml
# SIMPLEAPI_CAF_STORAGE_PATH_52=fiscal-secrets/caf/FoliosSII....xml
# SIMPLEAPI_CAF_STORAGE_PATH_56=fiscal-secrets/caf/FoliosSII....xml
# SIMPLEAPI_CAF_STORAGE_PATH_61=fiscal-secrets/caf/FoliosSII....xml
# SIMPLEAPI_CAF_STORAGE_PATH_46=fiscal-secrets/caf/FoliosSII....xml
SIMPLEAPI_LOGO_STORAGE_PATH=fiscal-secrets/HroLogo.png
SIMPLEAPI_ASSETS_BUCKET=the-hero-docs

# Optional: if empty, XML/PDF are stored in the default Firebase bucket.
# SIMPLEAPI_OUTPUT_BUCKET=the-hero-67d93.firebasestorage.app

# Issuer data (Emisor)
SIMPLEAPI_EMISOR_RUT=78330103-2
SIMPLEAPI_EMISOR_RAZON_SOCIAL=THE HERO SpA
SIMPLEAPI_EMISOR_GIRO=Actividades de Mensajeria
# Required for DTE schema. Example for mensajeria: 532000
SIMPLEAPI_EMISOR_ACTIVITY_CODES=532000
SIMPLEAPI_EMISOR_DIRECCION=Av. Casa de Piedra 452, casa 48, Colina Region Metropolitana
SIMPLEAPI_EMISOR_COMUNA=Colina
SIMPLEAPI_EMISOR_CIUDAD=Colina
# Optional fallback when receiver comuna is not explicitly provided
SIMPLEAPI_DEFAULT_RECEPTOR_COMUNA=Colina
# Optional fallback when receiver ciudad is not explicitly provided
SIMPLEAPI_DEFAULT_RECEPTOR_CIUDAD=Colina
# Optional labels used by PDF rendering so these fields are not empty
SIMPLEAPI_DEFAULT_VENDEDOR=THE HERO
SIMPLEAPI_DEFAULT_FORMA_PAGO=Contado
SIMPLEAPI_DEFAULT_CONDICION_VENTA=Contado
# Optional DTE numeric fallback (SII FmaPago: 1=Contado, 2=Credito, 3=Sin costo)
SIMPLEAPI_DEFAULT_FMA_PAGO=1

# SII resolution data (PDF rendering)
SIMPLEAPI_SII_RESOLUTION_NUMBER=0
SIMPLEAPI_SII_UNIT=SII
SIMPLEAPI_SII_RESOLUTION_DATE=2026-01-01
SIMPLEAPI_LOGO_FIT=contain
# Si no se define en payload, los callables fiscales generan PDF por defecto.
SIMPLEAPI_DEFAULT_INCLUDE_PDF=true
