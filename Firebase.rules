rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isRider() {
      return isAuthenticated()
        && (
          (
            (getUserData().roles is list)
            && getUserData().roles.hasAny(['rider'])
          )
          || (getUserData().riderProfile is map)
        );
    }

    function isWebAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/web_admins/$(request.auth.uid));
    }

    function _authCountryCode() {
      let data = getUserData();
      let address = data.get('address', {});
      let primarySlot = data.get('primaryAddressSlot', data.get('primaryAddressUnitType', ''));
      let slots = data.get('addressSlots', data.get('addressUnits', {}));
      let primaryAddress = (
        (primarySlot is string)
        && (slots is map)
        && (slots[primarySlot] is map)
      ) ? slots[primarySlot] : {};
      let fromPrimary = (primaryAddress is map) ? primaryAddress.get('countryCode', '') : '';
      let fromAddress = (address is map) ? address.get('countryCode', '') : '';
      return (fromPrimary is string && fromPrimary.size() > 0)
        ? fromPrimary
        : fromAddress;
    }

    function _orderCountryMatchesAuth(data) {
      let orderCountry = data.get('countryCode', '');
      let authCountry = _authCountryCode();
      return orderCountry is string
        && authCountry is string
        && orderCountry.size() > 0
        && authCountry.size() > 0
        && orderCountry == authCountry;
    }

    function _orderSellerContainsUid(data, uid) {
      return ('sellerHeroIds' in data)
        && (
          (
            (data.sellerHeroIds is list)
            && (
              (uid in data.sellerHeroIds)
              || data.sellerHeroIds.hasAny([uid])
            )
          )
          || (
            (data.sellerHeroIds is string)
            && data.sellerHeroIds == uid
          )
        );
    }

    function _isOrderParticipant(data, uid) {
      return data.get('heroId', '') == uid
        || _orderSellerContainsUid(data, uid)
        || (
          (data.get('rider', null) is map)
          && ('assignedRiderId' in data.rider)
          && data.rider.assignedRiderId == uid
        );
    }

    function _orderHasNoAssignedRider(data) {
      return !('rider' in data)
        || !(data.rider is map)
        || !('assignedRiderId' in data.rider)
        || data.rider.assignedRiderId == null
        || data.rider.assignedRiderId == '';
    }

    function _canReadPaymentByOrderDoc(data) {
      let rawOrderId = data.get('orderId', '');
      let orderId = (rawOrderId is string) ? rawOrderId : '';
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let orderData = orderExists ? get(orderPath).data : {};

      return isAuthenticated()
        && orderId.size() > 0
        && orderExists
        && _isOrderParticipant(orderData, request.auth.uid);
    }

    function _canReadPaymentForQueuedOrder(data) {
      let rawOrderId = data.get('orderId', '');
      let orderId = (rawOrderId is string) ? rawOrderId : '';
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let orderData = orderExists ? get(orderPath).data : {};

      return isRider()
        && orderId.size() > 0
        && orderExists
        && orderData.status == 'queued'
        && _orderHasNoAssignedRider(orderData)
        && _orderCountryMatchesAuth(orderData);
    }

    function _isAssignedRiderForOrder(orderId, riderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let orderData = orderExists ? get(orderPath).data : {};
      let rider = orderExists ? orderData.get('rider', {}) : {};

      return orderExists
        && (rider is map)
        && rider.get('assignedRiderId', '') == riderId;
    }

    function _canReadRiderLocationForOrder(orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let orderData = orderExists ? get(orderPath).data : {};

      return isAuthenticated()
        && orderExists
        && _isOrderParticipant(orderData, request.auth.uid);
    }

    function _validRiderLocationFields(data, riderId) {
      return data.riderId == riderId
        && data.geo is latlng
        && data.accuracy is number
        && data.updatedAt is timestamp;
    }

    function _validRiderLocationCreate(riderId) {
      return request.resource.data.keys().hasOnly([
          'riderId',
          'geo',
          'accuracy',
          'updatedAt'
        ])
        && _validRiderLocationFields(request.resource.data, riderId);
    }

    function _validRiderLocationUpdate(riderId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'riderId',
          'geo',
          'accuracy',
          'updatedAt'
        ])
        && _validRiderLocationFields(request.resource.data, riderId);
    }

    function _canReadPaymentByUserOrderIndex(data) {
      let rawOrderId = data.get('orderId', '');
      let orderId = (rawOrderId is string) ? rawOrderId : '';
      let indexPath = /databases/$(database)/documents/user_orders/$(request.auth.uid)/orders/$(orderId);
      let indexExists = exists(indexPath);
      let indexData = indexExists ? get(indexPath).data : {};
      let role = indexData.get('role', '');
      let indexedOrderId = indexData.get('orderId', '');

      return isAuthenticated()
        && orderId.size() > 0
        && indexExists
        && indexedOrderId == orderId
        && (role == 'buyer' || role == 'seller');
    }

    function _isCashPaymentData(data) {
      return data.get('paymentMethodId', '') == 'cash'
        || data.get('statusDetail', '') in ['cash_on_delivery', 'cash_collected'];
    }

    function _canCreateCashPayment(paymentId) {
      return _canReadPaymentByOrderDoc(request.resource.data)
        && paymentId.matches('^cash-.+')
        && _isCashPaymentData(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.orderId is string
        && request.resource.data.amount is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function _canConfirmCashPayment(paymentId) {
      return _canReadPaymentByOrderDoc(resource.data)
        && paymentId.matches('^cash-.+')
        && _isCashPaymentData(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.statusDetail == 'cash_collected'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'statusDetail',
          'approvedAt',
          'updatedAt',
          'metadata'
        ])
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function _canReadInvoiceDoc(data) {
      let payerUserId = data.get('payerUserId', '');
      let sellerUserId = data.get('sellerUserId', '');
      return isAuthenticated()
        && (
          payerUserId == request.auth.uid
          || sellerUserId == request.auth.uid
          || request.auth.token.admin == true
          || request.auth.token.support == true
        );
    }

    function _isOrderOwnedByAuth(orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      return isAuthenticated()
        && orderExists
        && get(orderPath).data.heroId == request.auth.uid;
    }

    function _canWriteUserOrderIndex(userId, orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let orderData = orderExists ? get(orderPath).data : {};
      let orderHeroId = orderData.get('heroId', '');
      let requestedOrderId = request.resource.data.get('orderId', '');
      let requestedHeroId = request.resource.data.get('heroId', '');
      let requestedRole = request.resource.data.get('role', '');
      let isBuyerIndex = userId == orderHeroId;
      let isSellerIndex = _orderSellerContainsUid(orderData, userId);

      return isAuthenticated()
        && orderExists
        && request.auth.uid == orderHeroId
        && requestedOrderId == orderId
        && requestedHeroId == orderHeroId
        && (
          (isBuyerIndex && requestedRole == 'buyer')
          || (!isBuyerIndex && isSellerIndex && requestedRole == 'seller')
        );
    }
    
    function _isRiderUnassignUpdate() {
      return resource.data.status == 'assigned'
        && (resource.data.rider is map)
        && ('assignedRiderId' in resource.data.rider)
        && resource.data.rider.assignedRiderId == request.auth.uid
        && request.resource.data.status == 'queued'
        && (
          !('timestamps' in resource.data)
          || !(resource.data.timestamps is map)
          || !('pickedUpAt' in resource.data.timestamps)
          || resource.data.timestamps.pickedUpAt == null
        )
        && (request.resource.data.rider is map)
        && request.resource.data.rider.size() == 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'rider',
          'pickupProgress',
          'cashHoldReleased',
          'timestamps',
          'updatedAt'
        ]);
    }

    function _isAssignedRider() {
      return isAuthenticated()
        && (resource.data.rider is map)
        && ('assignedRiderId' in resource.data.rider)
        && resource.data.rider.assignedRiderId == request.auth.uid;
    }

    function _pickupProgressFieldsSafe() {
      let beforeProgress = resource.data.get('pickupProgress', {});
      let afterProgress = request.resource.data.get('pickupProgress', {});
      return afterProgress is map
        && afterProgress.get('currentStopIndex', -1) is int
        && afterProgress.get('updatedAt', request.time) is timestamp
        && (
          (
            !(beforeProgress is map)
            && afterProgress.keys().hasOnly([
              'currentStopIndex',
              'updatedAt'
            ])
          )
          || (
            beforeProgress is map
            && afterProgress
              .diff(beforeProgress)
              .changedKeys()
              .hasOnly([
                'currentStopIndex',
                'updatedAt'
              ])
          )
        );
    }

    function _isRiderStatusTransition() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      let isValidTransition =
        (from == 'assigned' && to == 'picked_up')
        || (from == 'picked_up' && to == 'in_transit')
        || (from == 'in_transit' && to == 'delivered');
      let baseKeys = ['status', 'timestamps', 'updatedAt'];
      let deliveredKeys = [
        'status',
        'timestamps',
        'updatedAt',
        'riderEarningsProcessed',
        'riderEarningsProcessedAt',
        'riderEarningsSnapshot',
        'riderCashSnapshot',
        'cashSettlementProcessed'
      ];

      return _isAssignedRider()
        && isValidTransition
        && (
          (to != 'delivered'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(baseKeys))
          || (to == 'delivered'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(deliveredKeys))
        );
    }

    function _isSellerInPersonStatusTransition() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return isAuthenticated()
        && resource.data.inPersonPickup == true
        && _orderSellerContainsUid(resource.data, request.auth.uid)
        && (
          ((from in ['paid', 'queued', 'assigned']) && to == 'picked_up')
          || ((from in ['picked_up', 'in_transit']) && to == 'delivered')
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'timestamps',
          'updatedAt'
        ]);
    }

    function _isPickupProgressUpdate() {
      return _isAssignedRider()
        && resource.data.status == 'assigned'
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'pickupProgress',
          'updatedAt'
        ])
        && _pickupProgressFieldsSafe();
    }

    function _isHeroPaymentMetadataUpdate() {
      return isAuthenticated()
        && resource.data.heroId == request.auth.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'paymentPreferenceId',
          'paymentExpiresAt',
          'paymentStatus',
          'updatedAt'
        ])
        && request.resource.data.paymentStatus == 'pending';
    }

    function _isHeroConfirmationOrRatingUpdate() {
      return isAuthenticated()
        && resource.data.heroId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'confirmedByHero',
          'heroRating',
          'heroRatingComment',
          'sellerRating',
          'sellerRatingHeroId',
          'sellerRatingComment',
          'updatedAt'
        ])
        && (!('confirmedByHero' in request.resource.data)
          || request.resource.data.confirmedByHero == true)
        && (!('sellerRatingHeroId' in request.resource.data)
          || _orderSellerContainsUid(resource.data, request.resource.data.sellerRatingHeroId));
    }

    function _isSellerBuyerRatingUpdate() {
      return isAuthenticated()
        && _orderSellerContainsUid(resource.data, request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'buyerRating',
          'buyerRatingComment',
          'buyerRatingBySellerId',
          'buyerRatingAt',
          'updatedAt'
        ])
        && request.resource.data.buyerRatingBySellerId == request.auth.uid;
    }

    function _hasRiderProfile(data) {
      return data.riderProfile is map;
    }

    function _protectVerificationFields() {
      return !_hasRiderProfile(resource.data)
        || (
          request.resource.data.riderProfile.isVerified == resource.data.riderProfile.isVerified
          && request.resource.data.riderProfile.verification == resource.data.riderProfile.verification
        );
    }

    function _rolesAreClientSafe() {
      return !('roles' in request.resource.data)
        || (
          request.resource.data.roles is list
          && request.resource.data.roles.hasOnly(['hero', 'rider'])
        );
    }

    function _riderProfileSensitiveFieldsSafe() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['riderProfile'])
        || !('riderProfile' in request.resource.data)
        || !(request.resource.data.riderProfile is map)
        || (
          !(resource.data.riderProfile is map)
          && (!('isVerified' in request.resource.data.riderProfile)
            || request.resource.data.riderProfile.isVerified == false)
          && (!('verification' in request.resource.data.riderProfile)
            || request.resource.data.riderProfile.verification == null)
        )
        || (
          (resource.data.riderProfile is map)
          && request.resource.data.riderProfile.isVerified == resource.data.riderProfile.isVerified
          && request.resource.data.riderProfile.verification == resource.data.riderProfile.verification
        );
    }

    function _isZeroRiderWallet(wallet) {
      return wallet is map
        && wallet.get('cashBalance', 0) == 0
        && wallet.get('cashOnHold', 0) == 0
        && wallet.get('earningsBalance', 0) == 0
        && wallet.get('totalEarnings', 0) == 0
        && wallet.get('cashBalanceCents', 0) == 0
        && wallet.get('cashOnHoldCents', 0) == 0
        && wallet.get('earningsBalanceCents', 0) == 0
        && wallet.get('totalEarningsCents', 0) == 0;
    }

    function _riderWalletUnchangedOrInitialized() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['riderWallet'])
        || !('riderWallet' in request.resource.data)
        || (
          resource.data.riderWallet is map
          && request.resource.data.riderWallet == resource.data.riderWallet
        )
        || (
          !(resource.data.riderWallet is map)
          && _isZeroRiderWallet(request.resource.data.riderWallet)
        );
    }

    function _preserveRiderProfile() {
      return !(resource.data.riderProfile is map)
        || (
          request.resource.data.riderProfile is map
          && request.resource.data.riderProfile.isVerified == resource.data.riderProfile.isVerified
          && request.resource.data.riderProfile.verification == resource.data.riderProfile.verification
        );
    }
     
    function _canUpdateVehicleType() {
      return !_hasRiderProfile(resource.data)
        || !('vehicle' in request.resource.data.riderProfile)
        || !(request.resource.data.riderProfile.vehicle is map)
        || !('type' in request.resource.data.riderProfile.vehicle)
        || (
          request.resource.data.riderProfile.vehicle.type == resource.data.riderProfile.vehicle.type
          || (
            request.resource.data.riderProfile.vehicle.type == 'bicycle'
          )
          || (
            resource.data.riderProfile.isVerified == true
            && request.resource.data.riderProfile.isVerified == resource.data.riderProfile.isVerified
            && _hasValidDocsForVehicle(
              request.resource.data.riderProfile.vehicle.type,
              request.resource.data.riderProfile.documents
            )
          )
        );
    }

    function _hasValidDocsForVehicle(vehicleType, docs) {
      return (vehicleType == 'bicycle')
        || (vehicleType != 'bicycle'
          && docs.licenseUrl is string && docs.licenseUrl.size() > 0
          && docs.padronUrl is string && docs.padronUrl.size() > 0);
    }

    function _clientAllowedVehicleVerificationStatus(status) {
      return status == 'submitted' || status == 'approved' || status == 'not_required';
    }

    function _vehicleTypeSafe(typeKey, v) {
      return !(v is map)
        || !('vehicle' in v)
        || !(v.vehicle is map)
        || !('type' in v.vehicle)
        || v.vehicle.type == typeKey;
    }

    function _vehicleOcrNotWritable(typeKey, v) {
      let oldVehicles = (
        resource.data.riderProfile is map
        && resource.data.riderProfile.vehicles is map
      ) ? resource.data.riderProfile.vehicles : {};
      let oldEntry = (
        typeKey in oldVehicles
        && oldVehicles[typeKey] is map
      ) ? oldVehicles[typeKey] : {};
      return !(v is map)
        || !('ocr' in v)
        || ('ocr' in oldEntry && v.ocr == oldEntry.ocr);
    }

    function _vehicleFieldsValidForType(typeKey, v) {
      return !(v is map)
        || !('vehicle' in v)
        || !(v.vehicle is map)
        || (
          // Bicycle: must not include car-like fields
          (typeKey == 'bicycle'
            && !('plateNumber' in v.vehicle)
            && !('model' in v.vehicle)
            && !('year' in v.vehicle)
            && !('color' in v.vehicle)
          )
          || (typeKey != 'bicycle'
            && (!('plateNumber' in v.vehicle) || (v.vehicle.plateNumber is string && v.vehicle.plateNumber.size() > 0))
            && (!('model' in v.vehicle) || (v.vehicle.model is string && v.vehicle.model.size() > 0))
            && (!('color' in v.vehicle) || (v.vehicle.color is string && v.vehicle.color.size() > 0))
            && (!('year' in v.vehicle) || (v.vehicle.year is int))
          )
        );
    }

    function _vehicleEntrySchemaSafe(typeKey) {
      let vehicles = request.resource.data.riderProfile.vehicles;
      return !(typeKey in vehicles)
        || (
          _vehicleTypeSafe(typeKey, vehicles[typeKey])
          && _vehicleOcrNotWritable(typeKey, vehicles[typeKey])
          && _vehicleFieldsValidForType(typeKey, vehicles[typeKey])
        );
    }

    function _vehicleVerificationEntryStatusSafe(typeKey) {
      let vehicles = request.resource.data.riderProfile.vehicles;
      let v = vehicles[typeKey];
      return !(typeKey in vehicles)
        || !(v is map)
        || !('verification' in v)
        || !(v.verification is map)
        || !('status' in v.verification)
        || _clientAllowedVehicleVerificationStatus(v.verification.status);
    }

    function _vehiclesSchemaSafe() {
      return !_hasRiderProfile(resource.data)
        || !('vehicles' in request.resource.data.riderProfile)
        || !(request.resource.data.riderProfile.vehicles is map)
        || (
          request.resource.data.riderProfile.vehicles.keys().hasOnly([
            'bicycle',
            'motorcycle',
            'car',
            'truck'
          ])
          && _vehicleEntrySchemaSafe('bicycle')
          && _vehicleEntrySchemaSafe('motorcycle')
          && _vehicleEntrySchemaSafe('car')
          && _vehicleEntrySchemaSafe('truck')
        );
    }

    function _vehicleVerificationStatusSafe() {
      return !_hasRiderProfile(resource.data)
        || !('vehicles' in request.resource.data.riderProfile)
        || !(request.resource.data.riderProfile.vehicles is map)
        || (
          _vehicleVerificationEntryStatusSafe('bicycle')
          && _vehicleVerificationEntryStatusSafe('motorcycle')
          && _vehicleVerificationEntryStatusSafe('car')
          && _vehicleVerificationEntryStatusSafe('truck')
        );
    }

    function _clientUpdatableVehicleRequestStatus(status) {
      return status in [
        'processing',
        'submitted',
        'needs_review',
        'rejected',
        'failed',
        'canceled',
        'superseded'
      ];
    }

    function _clientAllowedRutVerificationStatus(status) {
      return status in ['pending', 'submitted', 'failed', 'rejected', 'needs_review', 'not_required'];
    }

    function _rutVerificationStatusSafeForOwnerUpdate() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['rutVerification'])
        || !('rutVerification' in request.resource.data)
        || !(request.resource.data.rutVerification is map)
        || !('status' in request.resource.data.rutVerification)
        || _clientAllowedRutVerificationStatus(request.resource.data.rutVerification.status);
    }

    function _clientAllowedLicenseVerificationStatus(status) {
      return status in ['pending', 'submitted', 'failed', 'rejected'];
    }

    function _hasRequiredDonationPublicationAnswers(data) {
      return data.get('isInGoodState', false) == true
        && data.get('worksCorrectly', false) == true;
    }

    function _donationHasOrders(data) {
      let orderCount = data.get('orderCount', 0);
      return orderCount is int && orderCount > 0;
    }

    function _offerOrderCountUnchanged() {
      let before = resource.data.get('orderCount', 0);
      let after = request.resource.data.get('orderCount', before);
      return after == before;
    }

    function _identityFieldUnchangedOrWasEmpty(fieldKey) {
      return !(resource.data.identity is map)
        || !(request.resource.data.identity is map)
        || (
          request.resource.data.identity[fieldKey] == resource.data.identity[fieldKey]
          || (
            (resource.data.identity[fieldKey] is string)
            && resource.data.identity[fieldKey].size() == 0
            && (request.resource.data.identity[fieldKey] is string)
            && request.resource.data.identity[fieldKey].size() > 0
          )
        );
    }

    function _identityIsImmutableAfterSet() {
      return (request.resource.data.identity is map)
        && _identityFieldUnchangedOrWasEmpty('firstName')
        && _identityFieldUnchangedOrWasEmpty('lastName')
        && _identityFieldUnchangedOrWasEmpty('documentType')
        && _identityFieldUnchangedOrWasEmpty('documentId');
    }

    // ==========================================
    // COLECCIÓN: ORDERS
    // ==========================================

    match /orders/{orderId} {
      // Seller list view: supports queries like
      // orders.where('sellerHeroIds', arrayContains: request.auth.uid).
      allow list: if isAuthenticated()
        && request.auth.uid in resource.data.sellerHeroIds;

      allow read: if isAuthenticated()
        && (
          resource.data.heroId == request.auth.uid
          || _orderSellerContainsUid(resource.data, request.auth.uid)
          || (
            (resource.data.rider is map)
            && ('assignedRiderId' in resource.data.rider)
            && resource.data.rider.assignedRiderId == request.auth.uid
          )
        );

      // Riders can read queued orders to see available deliveries.
      allow read: if isRider()
        && resource.data.status == 'queued'
        && _orderCountryMatchesAuth(resource.data);

      // Orders are created through Cloud Functions so the weekly hero limit
      // cannot be bypassed by direct client writes.
      allow create: if false;

      allow update: if _isHeroPaymentMetadataUpdate();
      allow update: if _isPickupProgressUpdate();
      allow update: if _isRiderStatusTransition();
      allow update: if _isSellerInPersonStatusTransition();
      allow update: if _isHeroConfirmationOrRatingUpdate();
      allow update: if _isSellerBuyerRatingUpdate();

      // Rider can unassign themselves (assigned -> queued) before pickup.
      allow update: if isAuthenticated() && _isRiderUnassignUpdate();

      // Allow the hero to delete an order only while it is unpaid / pending payment.
      allow delete: if isAuthenticated()
        && resource.data.heroId == request.auth.uid
        && resource.data.status in ['created', 'pending_payment', 'pendingPayment', 'pendingpayment'];

      match /rider_location/{riderId} {
        allow read: if _canReadRiderLocationForOrder(orderId);

        allow create: if isAuthenticated()
          && request.auth.uid == riderId
          && _isAssignedRiderForOrder(orderId, riderId)
          && _validRiderLocationCreate(riderId);

        allow update: if isAuthenticated()
          && request.auth.uid == riderId
          && _isAssignedRiderForOrder(orderId, riderId)
          && _validRiderLocationUpdate(riderId);

        allow delete: if false;
      }
    }

    match /payments/{paymentId} {
      // Allow order participants to read payment documents (used by watchPaymentByOrderId queries).
      allow read: if _canReadPaymentByOrderDoc(resource.data)
        || _canReadPaymentForQueuedOrder(resource.data)
        || _canReadPaymentByUserOrderIndex(resource.data);
      allow create: if _canCreateCashPayment(paymentId);
      allow update: if _canConfirmCashPayment(paymentId);
      allow delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if _canReadInvoiceDoc(resource.data);
      allow create, update, delete: if false;
    }

    match /stockReservations/{orderId} {
      // Only the hero owning the related order can read/modify the reservation.
      allow read: if _isOrderOwnedByAuth(orderId);

      // Client can only mark as released.
      allow update: if _isOrderOwnedByAuth(orderId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'releasedAt'
        ])
        && request.resource.data.status == 'released'
        && request.resource.data.releasedAt is timestamp;

      allow create, delete: if false;
    }

    match /user_orders/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create, update: if _canWriteUserOrderIndex(userId, orderId);
      allow delete: if false;
    }

    match /offers/{offerId} {
      allow read: if resource.data.status == 'active' || resource.data.status == 'sold_out';
      allow read: if isOwner(resource.data.heroId);
      allow read: if isWebAdmin();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isAuthenticated()
          && request.resource.data.offerId == offerId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'text',
            'updatedAt'
          ]);

        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/offers/$(offerId)).data.heroId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'reply',
            'replyBy',
            'repliedAt',
            'updatedAt'
          ]);

        allow delete: if false;
      }

      match /questions/{questionId} {
        allow read: if true;

        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'offerId',
            'askerId',
            'askerName',
            'question',
            'createdAt',
            'answer',
            'answeredById',
            'answeredAt',
            'questionId'
          ])
          && request.resource.data.offerId == offerId
          && request.resource.data.askerId == request.auth.uid
          && request.resource.data.askerName is string
          && request.resource.data.question is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.answer == null
          && request.resource.data.answeredById == null
          && request.resource.data.answeredAt == null
          && request.resource.data.questionId == '';

        allow update: if isAuthenticated()
          && resource.data.askerId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'questionId'
          ])
          && request.resource.data.questionId == questionId;

        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/offers/$(offerId)).data.heroId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'answer',
            'answeredById',
            'answeredAt'
          ])
          && request.resource.data.answer is string
          && request.resource.data.answeredById == request.auth.uid
          && request.resource.data.answeredAt is timestamp;

        allow delete: if false;
      }

      match /reports/{reporterId} {
        allow create: if isAuthenticated()
          && reporterId == request.auth.uid
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.offerId == offerId;

        allow read: if isAuthenticated() && reporterId == request.auth.uid;
        allow read: if isWebAdmin();
        allow update, delete: if false;
      }

      // Web admins (support) can moderate offers.
      // If moderationStatus is updated, enforce allowed enum values.
      allow update: if isWebAdmin()
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['moderationStatus'])
          || request.resource.data.moderationStatus in ['visible', 'hidden', 'blocked']
        );

      allow delete: if isWebAdmin();

      // Allow authenticated users to increment viewCount when opening details.
      allow update: if isAuthenticated()
        && (resource.data.status == 'active' || resource.data.status == 'sold_out')
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'viewCount'
        ])
        && (request.resource.data.viewCount is int)
        && request.resource.data.viewCount == (
          (('viewCount' in resource.data && resource.data.viewCount is int)
            ? resource.data.viewCount
            : 0) + 1
        );

      // Allow authenticated users to mark an offer for support review when reporting it.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'reportCount',
          'lastReportedAt',
          'supportReviewStatus'
        ])
        && (request.resource.data.reportCount is int)
        && request.resource.data.reportCount == (
          (('reportCount' in resource.data && resource.data.reportCount is int)
            ? resource.data.reportCount
            : 0) + 1
        )
        && (!('lastReportedAt' in request.resource.data)
          || request.resource.data.lastReportedAt == null
          || request.resource.data.lastReportedAt is timestamp)
        && (request.resource.data.supportReviewStatus == 'pending');

      allow create: if isAuthenticated() &&
                       request.resource.data.heroId == request.auth.uid &&
                       (request.resource.data.status == 'draft' || request.resource.data.status == 'active') &&
                       (
                         request.resource.data.status != 'active'
                         || _hasRequiredDonationPublicationAnswers(request.resource.data)
                       );

      // Owner can update their offer, but must not be able to write moderation/support fields.
      allow update: if isAuthenticated()
        && request.resource.data.heroId == request.auth.uid

        && (
          !('heroId' in resource.data)
          || resource.data.heroId == ''
          || resource.data.heroId == null
          || resource.data.heroId == request.auth.uid
        )
        && !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'moderationStatus',
          'reportCount',
          'lastReportedAt',
          'supportReviewStatus'
        ])
        && _offerOrderCountUnchanged()
        && (
          request.resource.data.status != 'active'
          || _hasRequiredDonationPublicationAnswers(request.resource.data)
        );

      allow delete: if isOwner(resource.data.heroId)
        && !_donationHasOrders(resource.data);
    }

    match /favorites/{userId}/offers/{offerId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // COLECCIÓN: OFFER_REPORTS
    // ==========================================

    match /offer_reports/{reportId} {
      allow create: if false;
      allow read: if isWebAdmin();
      allow update, delete: if false;
    }
    // COLECCIÓN: USER_REPORTS
    // ==========================================

    match /user_reports/{reportId} {
      allow create: if false;
      allow read: if isWebAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // COLECCIÓN: USERS
    // ==========================================

    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId);

      // Allow owner to fill missing profile fields even when the profile is incomplete.
      // This is intentionally limited to a small set of top-level keys and preserves identity immutability.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'identity',
          'contact',
          'status',
          'roles',
          'profilePhotoUrl'
        ])
        && _identityIsImmutableAfterSet();

      // Web admins (support) can moderate users (suspend/ban) with a narrow set of fields.
      allow update: if isWebAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'accountStatus',
          'suspendedUntil',
          'supportReviewStatus',
          'lastModeratedAt',
          'moderationNotes'
        ])
        && (!('accountStatus' in request.resource.data)
          || request.resource.data.accountStatus in ['active', 'suspended', 'banned'])
        && (!('suspendedUntil' in request.resource.data)
          || request.resource.data.suspendedUntil == null
          || request.resource.data.suspendedUntil is timestamp)
        && (!('supportReviewStatus' in request.resource.data)
          || request.resource.data.supportReviewStatus in ['pending', 'reviewed', 'dismissed'])
        && (!('lastModeratedAt' in request.resource.data)
          || request.resource.data.lastModeratedAt == null
          || request.resource.data.lastModeratedAt is timestamp)
        && (!('moderationNotes' in request.resource.data)
          || request.resource.data.moderationNotes == null
          || request.resource.data.moderationNotes is string);

      match /reports/{reporterId} {
        allow create: if isAuthenticated()
          && reporterId == request.auth.uid
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reportedUserId == userId;

        allow read: if isAuthenticated() && reporterId == request.auth.uid;
        allow read: if isWebAdmin();
        allow update, delete: if false;
      }

      // Allow authenticated users to mark a user for review by incrementing report counters.
      // Intentionally narrow: only reportCount (+1), lastReportedAt, and supportReviewStatus can change.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'reportCount',
          'lastReportedAt',
          'supportReviewStatus'
        ])
        && (request.resource.data.reportCount is int)
        && request.resource.data.reportCount == (
          (('reportCount' in resource.data && resource.data.reportCount is int)
            ? resource.data.reportCount
            : 0) + 1
        )
        && (!('lastReportedAt' in request.resource.data)
          || request.resource.data.lastReportedAt == null
          || request.resource.data.lastReportedAt is timestamp)
        && (request.resource.data.supportReviewStatus == 'pending');

      // Some clients use set(..., merge: true) when bootstrapping the user doc.
      // Firestore may require update permission even on the first write.
      // This allows an owner "update" only when the document does not exist yet.
      allow update: if isOwner(userId) && resource == null;

      // Allow owner to upgrade/complete profile (e.g., hero -> rider) with a limited set of fields.
      // This is intentionally narrower than a blanket owner update, but more tolerant than the
      // stricter validation rules below.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'authProvider',
          'identity',
          'contact',
          'status',
          'roles',
          'heroProfile',
          'riderProfile',
          'riderWallet',
          'rutVerification',
          'licenseVerification'
        ])
        && _rolesAreClientSafe()
        && _riderProfileSensitiveFieldsSafe()
        && _riderWalletUnchangedOrInitialized()
        && _rutVerificationStatusSafeForOwnerUpdate();

      // Allow owner to set/migrate authProvider (e.g., old accounts missing the field).
      // Client is only allowed to set it to a known value and optionally bump status.lastUpdated.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'authProvider',
          'status'
        ])
        && (request.resource.data.authProvider in ['google', 'password'])
        && (request.resource.data.status is map)
        && (request.resource.data.status.lastUpdated is string);

      // Allow owner to complete critical profile fields (RUT + phone) and role upgrades.
      // Uses changedKeys() because client updates often touch nested fields (identity.*, contact.*).
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'authProvider',
          'identity',
          'contact',
          'status',
          'roles',
          'heroProfile',
          'riderProfile',
          'riderWallet',
          'rutVerification',
          'licenseVerification'
        ])
        && _identityIsImmutableAfterSet()
        && (request.resource.data.identity is map)
        && (request.resource.data.identity.firstName is string)
        && (request.resource.data.identity.firstName.size() > 0)
        && (request.resource.data.identity.lastName is string)
        && (request.resource.data.identity.lastName.size() > 0)
        && (!('documentType' in request.resource.data.identity)
          || request.resource.data.identity.documentType is string)
        && (request.resource.data.identity.documentId is string)
        && (request.resource.data.identity.documentId.size() > 0)
        && (request.resource.data.contact is map)
        && (request.resource.data.contact.phoneNumber is string)
        && (request.resource.data.contact.phoneNumber.size() > 0)
        && (request.resource.data.status is map)
        && (request.resource.data.status.lastUpdated is string)
        && (request.resource.data.roles is list)
        && (!('heroProfile' in request.resource.data) || request.resource.data.heroProfile is map)
        && (!('riderProfile' in request.resource.data) || request.resource.data.riderProfile is map)
        && (!('rutVerification' in request.resource.data)
          || (request.resource.data.rutVerification is map))
        && _rutVerificationStatusSafeForOwnerUpdate()
        && _rolesAreClientSafe()
        && _riderProfileSensitiveFieldsSafe()
        && _riderWalletUnchangedOrInitialized();

      // Allow owner to update minimal licenseVerification fields (request id, timestamps) from client.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'licenseVerification',
          'licenseVerification.status',
          'licenseVerification.requestId',
          'licenseVerification.submittedAt',
          'licenseVerification.verifiedAt',
          'licenseVerification.mode'
        ])
        && (!('licenseVerification' in request.resource.data)
          || (request.resource.data.licenseVerification is map))
        && (!('licenseVerification' in request.resource.data)
          || !('status' in request.resource.data.licenseVerification)
          || _clientAllowedLicenseVerificationStatus(request.resource.data.licenseVerification.status))
        && (!('licenseVerification' in request.resource.data)
          || !('requestId' in request.resource.data.licenseVerification)
          || request.resource.data.licenseVerification.requestId is string)
        && (!('licenseVerification' in request.resource.data)
          || !('submittedAt' in request.resource.data.licenseVerification)
          || request.resource.data.licenseVerification.submittedAt is string)
        && (!('licenseVerification' in request.resource.data)
          || !('verifiedAt' in request.resource.data.licenseVerification)
          || request.resource.data.licenseVerification.verifiedAt == null
          || request.resource.data.licenseVerification.verifiedAt is string)
        && (!('licenseVerification' in request.resource.data)
          || !('mode' in request.resource.data.licenseVerification)
          || request.resource.data.licenseVerification.mode == null
          || request.resource.data.licenseVerification.mode is string);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['contact']);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'address',
          'addressUnits',
          'primaryAddressUnitType',
          'addressSlots',
          'primaryAddressSlot'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'fcmToken',
          'fcmTokenUpdatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'payoutMethod',
          'payoutMethodUpdatedAt'
        ])
        && isRider();

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['riderProfile'])
        && _hasValidDocsForVehicle(
          request.resource.data.riderProfile.vehicle.type,
          request.resource.data.riderProfile.documents
        );

      // Allow owner to update wallet counters/fields (cash balance / holds / earnings).
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'riderWallet',
          'riderWallet.cashBalance',
          'riderWallet.cashOnHold',
          'riderWallet.earningsBalance',
          'riderWallet.totalEarnings',
          'riderWallet.cashBalanceCents',
          'riderWallet.cashOnHoldCents',
          'riderWallet.earningsBalanceCents',
          'riderWallet.totalEarningsCents'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['riderProfile'])
        && _preserveRiderProfile()
        && _protectVerificationFields()
        && _canUpdateVehicleType()
        && _vehicleVerificationStatusSafe()
        && _vehiclesSchemaSafe();

      // Allow authenticated users to update rider rating when confirming delivery
      allow update: if isAuthenticated()
        && (resource.data.riderProfile is map)
        && (request.resource.data.riderProfile is map)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['riderProfile'])
        && request.resource.data.riderProfile.diff(resource.data.riderProfile).changedKeys().hasOnly(['rating', 'totalRatings']);

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/riderWalletTransactions/{txId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isRider()
        && request.resource.data.type in [
          'cash_hold',
          'cash_hold_release',
          'cash_settlement',
          'delivery_earnings'
        ]
        && request.resource.data.orderId is string
        && request.resource.data.amount is number
        && request.resource.data.amountCents is int
        && request.resource.data.currency is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/riderTripEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isRider()
        && request.resource.data.type == 'canceled_trip'
        && request.resource.data.orderId is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/vehicle_verification_requests/{requestId} {
      allow read, create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'updatedAt',
          'status'
        ])
        && request.resource.data.status in ['submitted', 'canceled', 'superseded']
        && _clientUpdatableVehicleRequestStatus(resource.data.status);
      allow delete: if false;
    }

    match /users/{userId}/rut_verification_requests/{requestId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.status in ['submitted', 'canceled', 'superseded'];

      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'updatedAt',
          'documents'
        ]);
      allow delete: if false;
    }

    match /users/{userId}/license_verification_requests/{requestId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.status in ['submitted', 'canceled', 'superseded'];

      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'updatedAt',
          'documents'
        ]);
      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: RIDER_STATS
    // ==========================================

    match /rider_stats/{riderId} {
      allow read: if isOwner(riderId) && isRider();
      allow create, update, delete: if false;
    }
    
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isOwner(userId);
    }
    
    // ==========================================
    // COLECCIÓN: NOTIFICATIONS (TOP-LEVEL)
    // ==========================================

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // COLECCIÓN: CHATS (REGLAS SIMPLIFICADAS)
    // ==========================================
    
    match /chats/{chatId} {
      // TEMPORARY: Ultra-permissive to match orders approach
      allow read, write: if isAuthenticated();
      
      // ==========================================
      // SUBCOLECCIÓN: MESSAGES
      // ==========================================
      match /messages/{messageId} {
        // TEMPORARY: Ultra-permissive to match orders approach
        allow read, write: if isAuthenticated();
      }
    }
    
    // ==========================================
    // COLECCIÓN: PROMO_BANNERS
    // ==========================================
    
    // COLECCION: CUPOS
    match /cupos/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /promo_banners/{doc} {
      allow read: if request.time < timestamp.date(9999, 1, 1);
    }
    
    // ==========================================
    // COLECCIÓN: WEB_ADMINS
    // ==========================================

    match /web_admins/{adminId} {
      // 'read' incluye tanto 'get' como 'list'
      allow read: if request.auth != null && (
        // Permitir si el usuario estÃ¡ consultando su propio perfil (necesario para el login)
        request.auth.uid == adminId || 
        // O permitir si el usuario que hace la consulta ya es un administrador verificado
        exists(/databases/$(database)/documents/web_admins/$(request.auth.uid))
      );

      // Mantener denegada la escritura directa desde el cliente por seguridad.
      // Para agregar o eliminar admins, se recomienda usar Firebase Admin SDK o Cloud Functions.
      allow write: if false;
    }

    // ==========================================
    // COLECCIÓN: PRICING
    // ==========================================

    match /settings/pricing {
      allow read: if request.auth != null;
      allow write: if false; // Las escrituras se manejan desde la Cloud Function
    }

    // ==========================================
    // REGLA POR DEFECTO (DENEGAR TODO)
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

