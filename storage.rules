rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Version procesada, solo lectura pública (ajusta a auth si prefieres)
    match /processed/{allPaths=**} {
      allow read: if true; // o request.auth != null si quieres proteger
      allow write: if false; // bloquea escrituras de clientes; Cloud Functions usa credenciales de servicio y no pasa por reglas
    }

    // Banners/promo
    match /ads/{allPaths=**} {
      allow read: if true; // público
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Ofertas (originales subidas por usuarios)
    match /offers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Documentos de verificación de vehículo (subidos por riders)
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Documentos de verificación de RUT (subidos por usuarios)
    match /users/{userId}/documents/rut_verification/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Foto de perfil (subida por el usuario)
    match /users/{userId}/profile/profile_photo/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Licencia de conducir (OCR) - subido por riders
    match /riders/{userId}/documents/driver_license/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Verificación por vehículo (OCR) - subido por riders
    match /riders/{userId}/documents/vehicle_verification/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Resto de paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
